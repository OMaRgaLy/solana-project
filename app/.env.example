NEXT_PUBLIC_PROGRAM_ID=7ze4Utjmn73v42terYZMTFVGCt2ygVu9u85US89uNGJm
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Telegram bot (optional). Create via @BotFather, then setWebhook with the secret below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT=
NEXT_PUBLIC_SITE_URL=
# Persistent bot state (Upstash Redis REST); in-memory fallback when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=


# Mainnet (real money). Leave PROGRAM_ID_MAINNET empty until the contract is deployed: the site then starts in
# demo (devnet). Once it is set, the site starts on mainnet and "Demo mode" becomes a button. See docs/MAINNET.md.
NEXT_PUBLIC_PROGRAM_ID_MAINNET=
NEXT_PUBLIC_RPC_URL_MAINNET=
# Platform wallet for the 1% fee on mainnet. Defaults to the project wallet in lib/cluster.ts.
NEXT_PUBLIC_TREASURY=
